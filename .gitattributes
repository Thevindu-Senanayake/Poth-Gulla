# These run inside Linux containers — force LF so a Windows checkout (autocrlf)
# can't corrupt the shebang / shell parsing.
*.sh            text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
nginx.conf      text eol=lf
