{
    "title": "Poth Gulla - API Overview",
    "uid": "poth-gulla-api",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "HTTP Request Rate (req/s)",
            "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "rate(http_requests_total[1m])",
                    "legendFormat": "{{method}} {{route}} {{status_code}}"
                }
            ]
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "HTTP P95 Latency (s)",
            "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[1m]))",
                    "legendFormat": "p95 {{route}}"
                }
            ]
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Total Requests",
            "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "sum(http_requests_total)"
                }
            ]
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Active Borrowings",
            "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "library_active_borrowings"
                }
            ]
        },
        {
            "id": 5,
            "type": "stat",
            "title": "Error Rate (%)",
            "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m])) * 100"
                }
            ]
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Bookings Created by Type",
            "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "rate(library_bookings_created_total[5m])",
                    "legendFormat": "{{resource_type}} → {{status}}"
                }
            ]
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "HTTP P50 / P99 Latency",
            "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
            "targets": [
                {
                    "datasource": "Prometheus",
                    "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[1m]))",
                    "legendFormat": "p50"
                },
                {
                    "datasource": "Prometheus",
                    "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[1m]))",
                    "legendFormat": "p99"
                }
            ]
        }
    ]
}
