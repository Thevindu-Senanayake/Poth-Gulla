{
    "name": "poth-gulla",
    "private": true,
    "packageManager": "yarn@1.22.22",
    "workspaces": {
        "packages": ["server", "web-client", "client"],
        "nohoist": [
            "**/react-native",
            "**/react-native/**",
            "**/expo",
            "**/expo/**",
            "**/expo-*",
            "**/expo-*/**",
            "**/react-native-*",
