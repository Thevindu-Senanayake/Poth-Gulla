# Rendered onto the droplet by the deploy job from GitHub Secrets - DO NOT commit a
# filled-in copy. Lists every key the deploy stack consumes.

# ---- Image refs (set by CI: digest-pinned, signed images) ----
SERVER_IMAGE=ghcr.io/<owner>/<repo>-server@sha256:<digest>
WEB_IMAGE=ghcr.io/<owner>/<repo>-web@sha256:<digest>

# ---- Postgres ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=poth_gulla

# ---- Backend (in-network hostnames) ----
DOCKER_DATABASE_URL=postgresql://admin:change-me@postgres:5432/poth_gulla?schema=public
DOCKER_REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=change-me
