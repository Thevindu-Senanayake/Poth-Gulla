    {
      "name": "Health",
      "item": [
        {
          "name": "Health check (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('status is ok or degraded', () => pm.expect(['ok','degraded']).to.include(res.status));",
                  "pm.test('has uptime field', () => pm.expect(res.uptime).to.be.a('number'));",
                  "pm.test('database field present', () => pm.expect(res.database).to.be.oneOf(['connected','disconnected']));",
                  "pm.test('X-Request-ID header set', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.match(/^[0-9a-f\\-]{36}$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}"
          }
        },
        {
          "name": "Health check — authenticated (shows auth field)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('auth field with userId present', () => pm.expect(res.auth).to.have.property('userId'));",
                  "pm.test('auth field with role present', () => pm.expect(res.auth).to.have.property('role'));",
                  "pm.test('X-Request-ID header set', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.match(/^[0-9a-f\\-]{36}$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}"
          }
        },
        {
          "name": "Health check — as Admin (shows system info)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('system block present for ADMIN', () => pm.expect(res).to.have.property('system'));",
                  "pm.test('memory.heapUsed present', () => pm.expect(res.system.memory).to.have.property('heapUsed'));",
                  "pm.test('pid present', () => pm.expect(res.system.pid).to.be.a('number'));"
                ]
              }
            }
          ],
          "description": "Login as admin@iit.ac.lk first (Auth → Login), then run this to see the system block.",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}"
          }
        }
      ]
    }
