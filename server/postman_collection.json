            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@iit.ac.lk\",\n  \"password\": \"Password123\",\n  \"name\": \"New User\",\n  \"role\": \"STUDENT\"\n}"
            }
          }
        },
        {
          "name": "Validation error demo (expect 400 with errors by field)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "const res = pm.response.json();",
                  "pm.test('message is Validation failed', () => pm.expect(res.message).to.equal('Validation failed'));",
                  "pm.test('errors object present', () => pm.expect(res).to.have.property('errors'));",
                  "pm.test('email errors keyed by field', () => pm.expect(res.errors).to.have.property('email'));",
                  "pm.test('X-Request-ID header set', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.match(/^[0-9a-f\\-]{36}$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"x\"\n}"
            }
          }
        }
      ]
